# Copie para .env na sua máquina/servidor. NUNCA publique o .env no Git.
NODE_ENV=development
HOST=127.0.0.1
PORT=8080
# Senha exclusiva do painel (mínimo 12 caracteres, não reutilizar)
ADMIN_PASSWORD=
# Segredo aleatório exclusivo (32 caracteres ou mais)
APP_SECRET=
# URL HTTPS definitiva quando NODE_ENV=production (na Render usa RENDER_EXTERNAL_URL automaticamente)
APP_PUBLIC_URL=
# Persistência local: SOMENTE um processo/réplica + volume persistente
DATA_FILE=./data/state.json
BUSINESS_FILE=./config/business.json
# Integração Chatwoot (opcional no simulador)
CHATWOOT_BASE_URL=
CHATWOOT_API_TOKEN=
CHATWOOT_WEBHOOK_SECRET=
CHATWOOT_ACCOUNT_ID=
CHATWOOT_INBOX_1=
CHATWOOT_INBOX_2=
# IA real: sem chave, o simulador retorna 503 e os webhooks encaminham para humano, sem fingir inteligência
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Segurança: impede envio real de WhatsApp em homologação; liberar somente após validação da operação.
# Requer simultaneamente NODE_ENV=production, credenciais válidas e revisão operacional.
WHATSAPP_OUTBOUND_ENABLED=false

# Integração com o Cardápio V2 do PDV (DESLIGADA por padrão)
# Ativar somente após catálogo 100% configurado, testado e com credenciais dedicadas.
CARDAPIO_V2_BOT_READ_ENABLED=false
CARDAPIO_V2_API_URL=
CARDAPIO_V2_CHATBOT_TOKEN=

# Gateway operacional do PDV — somente consultas, homologação, desligado por padrão.
# Configure no servidor do bot apenas após o endpoint do PDV estar validado no preview.
PDV_OPERATIONS_READ_ENABLED=false
PDV_OPERATIONS_API_URL=
PDV_OPERATIONS_READ_TOKEN=
# Mesmo token deve existir APENAS no projeto de preview do PDV como
# BOT_OPERATIONAL_READ_TOKEN, com BOT_OPERATIONAL_READ_ENABLED=true.
# Nunca habilitar em produção nem enviar este token ao modelo ou navegador.

# Pré-validação de pedido via API /api/v1/bot/order do PDV.
# PERMITIDO SOMENTE COM O MODO "test" CONFIGURADO NO PDV de homologação.
# O adaptador rejeita qualquer resposta em modo "active".
PDV_BOT_ORDER_TEST_ENABLED=false
PDV_BOT_ORDER_API_URL=
PDV_BOT_ORDER_TOKEN=

# Cardápio WhatsApp: link iOS somente após confirmar endereço oficial da App Store.
GUTO_IOS_APP_URL=
# PDF enviado via aba Cardápio WhatsApp no painel; o arquivo fica ao lado de DATA_FILE.
# Use volume persistente no ambiente de homologação. Máximo 16 MB por documento.
# Não habilitar WHATSAPP_OUTBOUND_ENABLED em homologação.
