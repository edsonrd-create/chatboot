# Copie para .env na sua máquina/servidor. NUNCA publique o .env no Git.
NODE_ENV=development
HOST=127.0.0.1
PORT=8080
# Senha exclusiva do painel (mínimo 12 caracteres, não reutilizar)
ADMIN_PASSWORD=
# Segredo aleatório exclusivo (32 caracteres ou mais)
APP_SECRET=
# URL HTTPS definitiva quando NODE_ENV=production
APP_PUBLIC_URL=
# Persistência local: SOMENTE um processo/réplica + volume persistente
DATA_FILE=./data/state.json
BUSINESS_FILE=./config/business.json
# Integração Chatwoot (opcional no simulador)
CHATWOOT_BASE_URL=
CHATWOOT_API_TOKEN=
CHATWOOT_WEBHOOK_SECRET=
CHATWOOT_ACCOUNT_ID=
CHATWOOT_INBOX_1=
CHATWOOT_INBOX_2=
# IA: sem chave, funciona somente como FAQ básico de demonstração
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
