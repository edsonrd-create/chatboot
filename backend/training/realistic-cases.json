        "payment": "PIX",
        "address": true,
        "text": "preços atualizados"
      },
      "turnChecks": {
        "0": "assistente virtual",
        "1": "carrinho",
        "2": "Coca",
        "3": "Anotei",
        "6": "preços atualizados"
      }
    },
