{
  "version": "1.1",
  "description": "Exemplos sintéticos inspirados na linguagem cotidiana de pedidos via WhatsApp. Não são conversas de clientes reais.",
  "cases": [
    {
      "id": "pedido-completo",
      "messages": [
        "Oi boa noite",
        "Quero uma grande meio calabresa e meio frango com catupiry",
