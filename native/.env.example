# CONFIGURE SOMENTE NO SERVIDOR. JAMAIS PUBLICAR .env OU ENVIAR TOKENS NO CHAT.
NODE_ENV=development
HOST=127.0.0.1
PORT=8080
# Produção: URL HTTPS real do backend
APP_PUBLIC_URL=
# Senha exclusiva do painel (mínimo 12 caracteres)
ADMIN_PASSWORD=
# Segredo forte aleatório (32+ caracteres) para cookies e criptografia em repouso
APP_SECRET=
# App Meta próprio da Guto Express
META_APP_ID=
META_CONFIG_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_GRAPH_VERSION=v25.0
# Opcional: conexão manual para números já autorizados no aplicativo Meta
META_PHONE_ID_1=
META_TOKEN_1=
META_PHONE_ID_2=
META_TOKEN_2=
# IA: selecione "gemini" ou "openai". A chave real fica SOMENTE no servidor.
# A chave enviada em conversas/prints deve ser revogada e substituída.
# Para usar Gemini, gere uma chave em https://aistudio.google.com/api-keys
# GEMINI_MODEL pode variar conforme quota / disponibilidade da sua conta.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Alternativa opcional:
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# IMPORTANTE: FREE_PREVIEW_MODE=true permanece SOMENTE LEITURA e bloqueia IA real.
# PDV: domínios estritamente autorizados para leitura
PDV_ALLOWED_HOSTS=pdvgutoexpress.com.br
# Persistência atual: apenas uma instância, volume não efêmero; trocar por Postgres antes de produção
DATA_FILE=./data/state.json

# Apenas prévia gratuita (bloqueia integração com clientes, Meta, PDV e chamadas de IA)
FREE_PREVIEW_MODE=false

# ===== WhatsApp QR (Baileys / não oficial) =====
# ATENÇÃO: este protocolo não é a API oficial da Meta; pode ser bloqueado.
# Na Railway, configure na aba Variables DO SERVIÇO QUE EXECUTA native/src/server.mjs,
# aplique as variáveis ao deployment e confirme em /api/qr/status após fazer login.
# WA_QR_ENABLED e WA_QR_AUTOREPLY precisam ser true para ativar respostas por QR.
WA_QR_ENABLED=false
WA_QR_AUTOREPLY=false
# Recomenda-se liberar SOMENTE números seus durante a homologação.
# Com a lista vazia, todos os clientes novos da sessão QR poderão receber resposta.
WA_QR_TEST_NUMBERS=
# A sessão QR precisa de dados persistentes; idealmente disco persistente criptografado
# onde ficam DATA_FILE e wa-auth/slot-1, wa-auth/slot-2. Não use disco efêmero para real.
# A IA real requer AI_PROVIDER=gemini + GEMINI_API_KEY (ou OPENAI_API_KEY se OpenAI).
# ÁUDIO BIDIRECIONAL (opt-in): áudio -> áudio OGG/Opus, texto -> texto.
# Ative apenas em número de teste homologado; exige Gemini + FFmpeg com libopus.
WA_QR_VOICE=false
GEMINI_TRANSCRIBE_MODEL=gemini-3.5-flash-lite
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TTS_VOICE=Kore
FFMPEG_PATH=ffmpeg
# Railway deve utilizar native/Dockerfile para instalar FFmpeg e libopus.
# Em /painel > WhatsApp QR > Verificar voz e FFmpeg, confira os resultados reais.
# Áudio máximo: 12 MB e 3 minutos; falha de compreensão -> atendimento humano.

# Trava global de segurança: em homologação deixe false.
# true só com NODE_ENV=production e autorização explícita após testes completos.
# Bloqueia respostas QR (texto/voz), anexos, respostas manuais e saída Meta.
WHATSAPP_OUTBOUND_ENABLED=false
